# Serve Hugo's generated 404 page for missing URLs on this domain.
# Deployed as-is by Hugo (static/ files are copied straight into public/).
ErrorDocument 404 /404.html

# www.bruce-loves-to-cook.ca -> bruce-loves-to-cook.ca, same path, permanent.
# Only matches the www host, so it's inert until that name points here.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.bruce-loves-to-cook\.ca$ [NC]
RewriteRule ^ https://bruce-loves-to-cook.ca%{REQUEST_URI} [R=301,L]
